#!/bin/sh
set -eu

topology=$(lscpu --parse=CPU,CORE,SOCKET,ONLINE)
cpu_set=$(printf '%s\n' "$topology" | awk -F, '
    $1 !~ /^#/ && $4 == "Y" {
        cpu_count++
        cpu[cpu_count] = $1

        if ($2 == "" || $2 == "-") {
            key[cpu_count] = "cpu:" $1
        } else {
            key[cpu_count] = $3 ":" $2
        }

        if (!(key[cpu_count] in core_number)) {
            core_count++
            core_number[key[cpu_count]] = core_count
        }
    }

    END {
        if (core_count == 0) {
            exit 1
        }

        selected_cores = int(core_count / 2)
        if (selected_cores < 1) {
            selected_cores = 1
        }

        separator = ""
        for (i = 1; i <= cpu_count; i++) {
            if (core_number[key[i]] <= selected_cores) {
                printf "%s%s", separator, cpu[i]
                separator = ","
                selected_cpus++
            }
        }
        printf "\n%d\n", selected_cpus
    }
')

cpu_count=$(printf '%s\n' "$cpu_set" | sed -n '2p')
cpu_set=$(printf '%s\n' "$cpu_set" | sed -n '1p')

if [ -z "$cpu_set" ] || [ -z "$cpu_count" ] || [ "$cpu_count" -lt 1 ]
then
    echo 'yay-limited: could not derive a usable CPU set from lscpu' >&2
    exit 1
fi

cpu_quota=$((cpu_count * 100))%

exec systemd-run \
    --user \
    --scope \
    --collect \
    --quiet \
    --expand-environment=no \
    --description='Resource-limited yay' \
    --property=MemoryHigh=45% \
    --property=MemoryMax=50% \
    --property=MemorySwapMax=0 \
    --property=CPUQuota="$cpu_quota" \
    --property=CPUWeight=10 \
    --property=TasksMax=512 \
    taskset --cpu-list "$cpu_set" \
    yay "$@"
